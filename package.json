{
  "name": "lead-qualifier",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "tsx scripts/verify.ts",
    "try:qualifier": "tsx --env-file=.env.local scripts/try-qualifier.ts",
    "send:test-call": "tsx --env-file=.env.local scripts/send-test-call.ts",
    "signal:fake": "tsx --env-file=.env.local scripts/fake-signal.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@vercel/blob": "^2.8.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
